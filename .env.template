# VBCUA Environment Variables Configuration

# Database URL. SQLite (a local vbcua.db file) is the default.
# Optional PostgreSQL: postgresql+psycopg2://username:password@hostname:port/database_name
DATABASE_URL=sqlite:///./vbcua.db

# Google Gemini API Key for semantic similarity, summarization, and detailed qualitative feedback
# You can obtain a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini model for AI feedback (and the optional transcription fallback)
# See https://ai.google.dev/gemini-api/docs/models for current model IDs
GEMINI_MODEL=gemini-3.8-flash

# Gemini thinking effort for feedback: minimal, low, medium, high (empty = model default)
GEMINI_THINKING_LEVEL=low

# Load Whisper and Sentence-BERT at backend startup (true/false)
PRELOAD_MODELS=true

# Whisper Model size (options: tiny, base, small, medium, large)
# "small" is the default: Whisper is always used for transcription
WHISPER_MODEL=small

# Fall back to Gemini transcription if local Whisper fails (true/false)
STT_GEMINI_FALLBACK=false

# Directory where uploaded audio files are saved
UPLOAD_DIR=./uploads
